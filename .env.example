# GEMINI_API_KEY: Required for Gemini AI API calls. Optional: the app falls back to measured-only output.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# API_TOKEN: Required in production. Every /api route needs this token (or a session from it).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_TOKEN="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SENDER_OPTOUT_EMAIL: Contact address for opt-out requests (read by the server; returned to the client via /api/sender).
SENDER_OPTOUT_EMAIL="support@ecompletecommerce.com"
